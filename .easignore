.git/
.github/

# Dependencies (installed on builder)
node_modules/

# Local Expo state
.expo/

# Editor settings
.vscode/

# Build artifacts
dist/
web-build/
android/.gradle/
android/.cxx/
android/**/build/
ios/Pods/

# Prebuild / CNG: не заливать закоммиченный ios/ на EAS — конфиг из app.json синхронизируется через prebuild
/ios

# Exclude heavy album subdirectories (export PDFs, full page sets).
# Keep: index.ts, kids first/last pages, DB cover pages.
/albums/export/
/albums/holiday/
/albums/family/
/albums/pregnant/
/albums/diary/

# Дневники: static require в diaryAlbumsLoader (DD*/first_page) и diaryInteriorAssets (блоки 60+40 стр.)
!/albums/diary/
!/albums/diary/DD*/
!/albums/diary/DD*/**
!/albums/diary/cover/
!/albums/diary/cover/in album/
!/albums/diary/cover/in album/**

# These lightweight cover/first-page assets are referenced by static require().
# They must stay in the EAS archive; otherwise Linux Metro cannot bundle them.
!/albums/holiday/
!/albums/holiday/first_pages/
!/albums/holiday/first_pages/**
!/albums/family/
!/albums/family/first_pages/
!/albums/family/first_pages/**
!/albums/pregnant/
!/albums/pregnant/**

# Exclude heavy PDF/page PNG content, but keep preview PNGs + manifests required by Metro.
/assets/pdfs/**
!/assets/pdfs/**/design_previews/
!/assets/pdfs/**/design_previews/**
!/assets/pdfs/**/preview_variants/
!/assets/pdfs/**/preview_variants/**

**/*.mp4
**/*.mov
**/*.mkv
**/*.avi
**/*.zip
**/*.7z
**/*.rar

# Logs and caches
*.log
npm-debug.log
yarn-error.log
coverage/
