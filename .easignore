.git/
.github/

# Dependencies (installed on builder)
node_modules/

# Local Expo state
.expo/

# Editor settings
.vscode/

# Build artifacts
dist/
web-build/
android/.gradle/
android/.cxx/
android/**/build/
ios/Pods/

# Large local content not needed for builds
# Keep the TS module that the app imports (`@/albums`), but exclude only root `albums/` content.
# Leading slash is important: without it, `albums/**` also excludes `assets/images/albums/**`.
/albums/**
!/albums/index.ts
!/albums/diary/**/*.png
!/albums/kids/**/first_page.png
!/albums/kids/**/last_page.png
!/albums/export/
!/albums/export/**
!albums/export/
!albums/export/**
**/*.mp4
**/*.mov
**/*.mkv
**/*.avi
**/*.zip
**/*.7z
**/*.rar

# Logs and caches
*.log
npm-debug.log
yarn-error.log
coverage/
