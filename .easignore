.git/
.github/

# Dependencies (installed on builder)
node_modules/

# Local Expo state
.expo/

# Editor settings
.vscode/

# Build artifacts
dist/
web-build/
android/.gradle/
android/.cxx/
android/**/build/
ios/Pods/

# Exclude heavy album subdirectories (export PDFs, full page sets).
# Keep: index.ts, kids first/last pages, DB cover pages.
/albums/export/
/albums/holiday/
/albums/family/
/albums/pregnant/
/albums/diary/

# Exclude heavy PDF content. Лёгкие превью для бандла лежат в assets/app-bundled/
# (вне /assets/pdfs/**), чтобы EAS всегда их загружал — отрицания в ignore легко сломать.
/assets/pdfs/**

**/*.mp4
**/*.mov
**/*.mkv
**/*.avi
**/*.zip
**/*.7z
**/*.rar

# Logs and caches
*.log
npm-debug.log
yarn-error.log
coverage/
