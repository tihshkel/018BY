.git/
.github/

# Dependencies (installed on builder)
node_modules/

# Local Expo state
.expo/

# Editor settings
.vscode/

# Build artifacts
dist/
web-build/
android/.gradle/
android/.cxx/
android/**/build/
ios/Pods/

# Prebuild / CNG: не заливать закоммиченный ios/ на EAS — конфиг из app.json синхронизируется через prebuild
/ios

# Exclude heavy album subdirectories (export PDFs, full page sets).
# Keep: index.ts, kids first/last pages, DB cover pages.
/albums/export/
/albums/holiday/
/albums/family/
/albums/pregnant/
/albums/diary/

# Дневники: static require в diaryAlbumsLoader (DD*/first_page) и diaryInteriorAssets (блоки 60+40 стр.)
# Внутрянка — только ASCII-пути albums/diary/interiors/{brown,purple} (Unicode ломает Android assets).
!/albums/diary/
!/albums/diary/DD*/
!/albums/diary/DD*/**
!/albums/diary/interiors/
!/albums/diary/interiors/**
!/albums/diary/cover/
!/albums/diary/cover/DD*
!/albums/diary/cover/DD*/**

# These lightweight cover/first-page assets are referenced by static require().
# They must stay in the EAS archive; otherwise Linux Metro cannot bundle them.
!/albums/holiday/
!/albums/holiday/first_pages/
!/albums/holiday/first_pages/**
!/albums/family/
!/albums/family/first_pages/
!/albums/family/first_pages/**
!/albums/pregnant/
!/albums/pregnant/**

# Exclude heavy PDF caches and full birthday page PNG set (loaded from GitHub at runtime).
/assets/pdfs/compressed/
/assets/pdfs/covers/
/assets/pdfs/optimized/
/assets/pdfs/**/*.pdf
/assets/pdfs/Блок ДНЕЙ РОЖДЕНИЯ 60 стр/
/assets/pdfs/Блок БЕРЕМЕННОСТЬ A5 другой блок/

**/*.mp4
**/*.mov
**/*.mkv
**/*.avi
**/*.zip
**/*.7z
**/*.rar

# Logs and caches
*.log
npm-debug.log
yarn-error.log
coverage/
