# Supabase — проект 018BY. Скопируйте в .env и подставьте publishable key.
# 1. cp .env.example .env
# 2. В .env вставьте ключ из Supabase Dashboard → Settings → API (Publishable key)
# 3. npx expo start --clear
# Подробнее: docs/SUPABASE_NEW_PROJECT.md

EXPO_PUBLIC_SUPABASE_URL=https://xbjssrfenkaefudhlgks.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key-here

# Розовые рамки зон ввода (только для отладки слотов): 1 = включено, 0 = выкл.
EXPO_PUBLIC_SHOW_LINE_SLOT_DEBUG=0

# Google Sign-In (нативный вход на iOS/Android). Web client обязателен; iOS client — для iOS.
# Подробнее: docs/GOOGLE_NATIVE_SIGNIN.md
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
