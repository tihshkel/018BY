# Одна БД на команду: скопируйте в .env и вставьте ОДИНАКОВЫЕ ключи у всех разработчиков.
# (файл .env в Git не попадает — ключи передаёт тот, кто первым настроил Supabase.)
#
# 1. cp .env.example .env
# 2. Подставьте URL и anon key (из Supabase Dashboard → API или от напарника)
# 3. npx expo start --clear
# Подробнее: docs/SUPABASE_SETUP.md

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
