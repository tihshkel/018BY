{
  "name": "018by",
  "main": "expo-router/entry",
  "version": "1.0.1",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "verify-project-save": "node ./scripts/verify-project-save.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "check:doctor": "expo-doctor",
    "check:assets-png": "node ./scripts/verify-assets-png.cjs",
    "check:android-icons": "node ./scripts/verify-android-launcher-icons.cjs",
    "check:bundle-android": "expo export --platform android",
    "check:eas-android": "npm run check:assets-png && npm run check:android-icons && npm run lint && npm run check:bundle-android",
    "build:ios": "npx eas-cli build --profile production --platform ios",
    "build:android": "npx eas-cli build --profile production --platform android",
    "build:preview:ios": "npx eas-cli build --profile preview --platform ios",
    "build:preview:android": "npx eas-cli build --profile preview --platform android",
    "submit:ios": "npx eas-cli submit --platform ios",
    "submit:ios:latest": "npx eas-cli submit -p ios --profile production --latest --wait --verbose",
    "submit:android": "npx eas-cli submit --platform android",
    "build:configure": "npx eas-cli build:configure",
    "postinstall": "patch-package",
    "generate:line-guides": "node ./scripts/generate-line-guides.js",
    "generate:line-slots": "node ./scripts/generate-line-slots.js",
    "generate:line-slots:png": "USE_PNG_SLOTS=1 node ./scripts/generate-line-slots.js",
    "visualize:line-slots": "node ./scripts/visualize-line-slots.js",
    "audit:line-slots": "node ./scripts/audit-line-slots.js",
    "verify:line-slots": "npm run generate:line-slots && npm run audit:line-slots",
    "analyze:page-fields": "node ./scripts/deep-analyze-page-fields.js"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@pdf-lib/fontkit": "^1.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@supabase/supabase-js": "^2.94.1",
    "expo": "~54.0.34",
    "expo-asset": "~12.0.10",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-clipboard": "^8.0.8",
    "expo-constants": "~18.0.10",
    "expo-dev-client": "~6.0.21",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "^19.0.17",
    "expo-font": "~14.0.9",
    "expo-haptics": "~15.0.8",
    "expo-iap": "^4.3.1",
    "expo-image": "~3.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-print": "~15.0.8",
    "expo-router": "~6.0.23",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.17",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-view-shot": "^4.0.3",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "patch-package": "^8.0.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "pngjs": "^7.0.0",
    "sharp": "^0.34.5",
    "typescript": "~5.9.2"
  },
  "private": true
}
