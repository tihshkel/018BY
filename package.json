{
  "name": "018by",
  "main": "expo-router/entry",
  "version": "1.1.7",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "verify-project-save": "node ./scripts/verify-project-save.js",
    "test:project-sync": "node ./scripts/test-project-sync-merge.js && node ./scripts/test-prune-ghost-score.js && node ./scripts/test-field-text-align.js && node ./scripts/test-normalize-album-user-text.js && node ./scripts/test-pregnancy-plans-capacity.js && node ./scripts/test-pregnancy-feelings-capacity.js && node ./scripts/test-export-preview-distribute-parity.js && node ./scripts/test-export-weekly-legacy-branch.js && node ./scripts/test-typography-font-picker.js && node ./scripts/test-ios-russian-localization.js && node ./scripts/test-widget-visual-design.js && node ./scripts/test-widget-snapshot-payload.js && node ./scripts/test-home-widget-stats.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "check:doctor": "expo-doctor",
    "check:assets-png": "node ./scripts/verify-assets-png.cjs",
    "check:android-icons": "node ./scripts/verify-android-launcher-icons.cjs",
    "check:bundle-android": "expo export --platform android",
    "check:eas-android": "npm run check:assets-png && npm run check:android-icons && npm run lint && npm run check:bundle-android",
    "build:ios": "npx eas-cli build --profile production --platform ios",
    "build:android": "npx eas-cli build --profile production --platform android",
    "build:preview:ios": "npx eas-cli build --profile preview --platform ios",
    "build:preview:android": "npx eas-cli build --profile preview --platform android",
    "submit:ios": "npx eas-cli submit --platform ios",
    "submit:ios:latest": "npx eas-cli submit -p ios --profile production --latest --wait --verbose",
    "submit:android": "npx eas-cli submit --platform android",
    "build:configure": "npx eas-cli build:configure",
    "postinstall": "patch-package",
    "generate:line-guides": "node ./scripts/generate-line-guides.js",
    "generate:line-slots": "node ./scripts/generate-line-slots.js",
    "generate:line-slots:png": "USE_PNG_SLOTS=1 node ./scripts/generate-line-slots.js",
    "visualize:line-slots": "node ./scripts/visualize-line-slots.js",
    "audit:line-slots": "node ./scripts/audit-line-slots.js",
    "calibrate:font-char-widths": "node ./scripts/calibrate-font-char-widths.js",
    "audit:text-line-capacity": "node ./scripts/calibrate-font-char-widths.js && node ./scripts/audit-text-line-capacity.js",
    "audit:text-line-capacity:fail": "FAIL_ON_ERROR=1 node ./scripts/calibrate-font-char-widths.js && FAIL_ON_ERROR=1 node ./scripts/audit-text-line-capacity.js",
    "audit:kids-48-pages": "node ./scripts/audit-kids-48-pages.js",
    "audit:kids-48-pages:visual": "node ./scripts/audit-kids-48-pages.js --visual",
    "audit:kids-48-text-visual": "node ./scripts/audit-kids-48-text-visual-baseline.js",
    "audit:album-photo-pages": "node ./scripts/audit-album-photo-pages.js",
    "audit:album-photo-pages:fail": "node ./scripts/audit-album-photo-pages.js --fail",
    "audit:pregnancy-photo": "node ./scripts/audit-album-photo-pages.js --album=pregnancy_60 && node ./scripts/audit-album-photo-pages.js --album=pregnancy_a5",
    "audit:pregnancy-stroke-alignment": "ONLY_ALBUM=pregnancy_60 node ./scripts/audit-pregnancy-stroke-alignment.js && ONLY_ALBUM=pregnancy_a5 node ./scripts/audit-pregnancy-stroke-alignment.js",
    "audit:pregnancy-stroke-alignment:fail": "ONLY_ALBUM=pregnancy_60 FAIL_ON_ERROR=1 node ./scripts/audit-pregnancy-stroke-alignment.js && ONLY_ALBUM=pregnancy_a5 FAIL_ON_ERROR=1 node ./scripts/audit-pregnancy-stroke-alignment.js",
    "audit:birthday-photo": "node ./scripts/audit-album-photo-pages.js --album=holidays_birthday_60",
    "audit:diary-photo": "node ./scripts/audit-album-photo-pages.js --album=diary_interior_brown && node ./scripts/audit-album-photo-pages.js --album=diary_interior_purple",
    "verify:line-slots": "npm run generate:line-slots && npm run audit:line-slots",
    "verify:diary-field-slots": "node ./scripts/verify-diary-field-slot-map.js",
    "analyze:page-fields": "node ./scripts/deep-analyze-page-fields.js",
    "verify:designed-albums": "npm run verify:line-slots && npm run calibrate:font-char-widths && npm run audit:text-line-capacity:fail && npm run audit:pregnancy-stroke-alignment:fail && node ./scripts/export-photo-pages-manifest.js && node ./scripts/generate-birthday-48-tz-manifest.js && node ./scripts/verify-field-labels.js && node ./scripts/verify-photo-flows.js && node ./scripts/verify-export-matrix.js && node ./scripts/verify-export-parity.js && node ./scripts/verify-photo-parity.js && node ./scripts/verify-tz-compliance.js && node ./scripts/verify-diary-field-slot-map.js && npm run audit:diary-field-semantic:fail && node ./scripts/diary-full-page-audit.js && npm run audit:diary-brown-text-baseline:fail && node ./scripts/audit-kids-48-pages.js --fail && node ./scripts/audit-album-photo-pages.js --fail",
    "test:e2e:designed-albums": "npx playwright test e2e/playwright/designed-albums-export.spec.ts",
    "generate:kids-covers": "node ./scripts/generate-kids-cover-designs.js",
    "sync:app-logo": "node ./scripts/sync-app-logo.js",
    "verify:blank-templates": "node ./scripts/verify-blank-template-compliance.js",
    "convert:diary-interior-pdfs": ".venv/bin/python3 ./scripts/convert-diary-interior-pdfs.py",
    "generate:diary-interior-assets": "node ./scripts/generate-diary-interior-assets.js",
    "refresh:diary-interiors": "npm run convert:diary-interior-pdfs && npm run generate:diary-interior-assets && node ./scripts/build-diary-brown-slot-overrides.js && node ./scripts/build-diary-purple-slot-overrides.js && npm run generate:line-slots",
    "audit:diary-brown-text-baseline": "node ./scripts/render-diary-brown-text-baseline-audit.js",
    "audit:diary-brown-text-baseline:fail": "FAIL_ON_DRIFT=1 node ./scripts/render-diary-brown-text-baseline-audit.js",
    "audit:diary-purple-text-baseline": "ALBUM_ID=diary_interior_purple node ./scripts/render-diary-brown-text-baseline-audit.js",
    "audit:diary-purple-text-baseline:fail": "FAIL_ON_DRIFT=1 ALBUM_ID=diary_interior_purple node ./scripts/render-diary-brown-text-baseline-audit.js",
    "audit:diary-field-semantic": "node ./scripts/audit-diary-field-semantic-map.js",
    "audit:diary-field-semantic:fail": "FAIL_ON_ERROR=1 node ./scripts/audit-diary-field-semantic-map.js",
    "audit:diary-stroke-alignment": ".venv/bin/python3 ./scripts/audit-diary-stroke-alignment.py",
    "audit:diary-stroke-alignment:fail": "FAIL_ON_ERROR=1 .venv/bin/python3 ./scripts/audit-diary-stroke-alignment.py",
    "audit:diary-font-size-parity": "node ./scripts/audit-diary-font-size-parity.js",
    "audit:diary-font-size-parity:fail": "FAIL_ON_ERROR=1 node ./scripts/audit-diary-font-size-parity.js",
    "audit:diary-all": "npm run audit:diary-brown-text-baseline:fail && npm run audit:diary-purple-text-baseline:fail && npm run audit:diary-field-semantic:fail && npm run audit:diary-stroke-alignment:fail && npm run audit:diary-font-size-parity:fail && ALBUM_ID=diary_interior_brown node ./scripts/verify-diary-field-slot-map.js && ALBUM_ID=diary_interior_purple node ./scripts/verify-diary-field-slot-map.js && node ./scripts/diary-full-page-audit.js && FAIL_ON_ERROR=1 node ./scripts/audit-diary-field-token-placement.js"
  },
